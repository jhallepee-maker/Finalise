# Finalise — variables d'environnement (copier en .env)
DATABASE_URL=postgresql://user:password@host:5432/finalise
JWT_SECRET=change_me_super_secret_key_min_32_chars
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=https://finalise.vercel.app
NODE_ENV=production
PORT=3000

# Emails (optionnel — sans clé, aucun email n est envoyé)
RESEND_API_KEY=
MAIL_FROM="Finalise <noreply@votre-domaine.fr>"

# Notifications push (Web Push) — clés générées avec : node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.fr
